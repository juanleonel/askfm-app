@model IEnumerable<askfm.Models.UserModel>

@{
    ViewData["Title"] = "Search";
}

<h2>Result for "@ViewBag.Query"</h2>

@if (!Model.Any())
{
    <p>Not found result using the criteria.</p>
}
else
{
    <div class="list-group">
        @foreach (var item in Model)
        {
            <div class="list-group-item py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="@item.Image" alt="Imagen de @item.UserName" class="rounded-circle me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                        }
                        <div>
                            <h5 class="mb-1">@item.UserName @item.LastName</h5>
                            <p class="mb-0 text-muted">
                                <strong>Email:</strong> @item.Email<br />
                                <strong>Location:</strong> @item.Location
                            </p>
                        </div>
                    </div>

                    <div class="text-end">
                        <a asp-controller="Preguntas" asp-action="Crear" asp-route-userId="@item.Id" class="btn btn-primary me-2">Ask</a>
                        <form asp-controller="Usuarios" asp-action="Seguir" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-success">Follow</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

}