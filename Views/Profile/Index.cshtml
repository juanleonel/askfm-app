@model askfm.Models.UserModel

@{
    ViewData["Title"] = "User profile";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3 text-center">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Model.Image" alt="Imagen de @Model.UserName" class="img-fluid rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 150px; height: 150px;">
                    <span class="fs-3">@Model.UserName.Substring(0, 1)</span>
                </div>
            }
        </div>

        <div class="col-md-9">
            <h2>@Model.UserName @Model.LastName</h2>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <div class="mt-4">
                <button type="submit" class="btn btn-outline-success">Follow</button>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row">
            <div class="col-md-12">
                <h4>Make a question @Model.UserName</h4>
                <form id="answerForm" method="post">
                    <input type="hidden" name="UserId" value="@Model.Id" />
                    <div class="mb-3">
                        <textarea name="Content" class="form-control" rows="4" placeholder="Write your question..." required></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="IsAnonymous" id="IsAnonymous" />
                        <label class="form-check-label" for="IsAnonymous">
                            Ask anonymously
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">Question</button>                  
                </form>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <h4>Questions</h4>
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    foreach (var comment in Model.Comments)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <p class="text-muted mb-1">@comment.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                                <p class="mb-1"><strong>Question:</strong> @comment.Content</p>
                                <p class="mb-1">
                                    <strong>Answer:</strong>
                                    @if (!string.IsNullOrEmpty(comment.Answers[0].Content))
                                    {
                                        @comment.Answers[0].Content
                                        <form asp-controller="Answers" asp-action="Delete" asp-route-id="@comment.Id" method="post" class="d-inline ms-2">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete answer</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not answered yet</span>
                                    }
                                </p>
                                <form asp-controller="Questions" asp-action="Delete" asp-route-id="@comment.Id" method="post" class="mt-2">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete question</button>
                                </form>
                            </div>
                        </div>
                    }

                }
                else
                {
                    <p class="text-muted">This user hasn't received any questions yet</p>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("answerForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);
        const data = {
            Content: form.querySelector("[name='Content']").value,
            UserId: form.querySelector("[name='UserId']").value,
            IsAnonymous: form.querySelector("[name='IsAnonymous']").checked
        };

        try {
            const response = await fetch('/profile/CreateComment', {
                headers: {
                    "Content-Type": "application/json"
                },
                method: "POST",
                body: JSON.stringify(data)
            });

            if (response.ok) {
                const result = await response.json(); // o .json() si devuelves JSON
                alert("Pregunta enviada correctamente");
                form.reset();
            } else {
                alert("Error al enviar la pregunta");
            }
        } catch (error) {
            console.error("Error:", error);
            alert("Ocurrió un error inesperado");
        }
    });
</script>